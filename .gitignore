.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.pytest-work/
*.egg-info/
.ipynb_checkpoints/
.jupyter/
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db

# Generated optimization/ML artifacts must use external artifact storage or outputs/.
*.pt
*.pth
*.ckpt
*.onnx
checkpoints/
runs/
wandb/
mlruns/
lightning_logs/

outputs/**
!outputs/**/
!outputs/**/.gitkeep

# Reproducible generated data. Raw inputs and transformation code remain tracked.
data/interim/**
!data/interim/**/
!data/interim/**/.gitkeep
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep
!data/processed/**/README.md

# Academic source generators are fetched with pinned checksums, never committed.
data/external/mpv_3dbpp/*.c
data/external/mpv_3dbpp/imported/**
data/external/mpv_3dbpp/sources/**

# Large Level 8 synthetic inputs are reproducibly generated from tracked YAML.
data/raw/level_08/generated/**
!data/raw/level_08/generated/
!data/raw/level_08/generated/.gitkeep

# Ignore exploratory reports folder (local, large, or generated)
docs/reports/explore/**
!docs/reports/explore/
!docs/reports/explore/.gitkeep
